{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Context.index 游标生命周期",
    "quality_profile": "showcase",
    "locale": "zh-CN",
    "output": "middleware/middleware-core/middleware-core-lifecycle.html"
  },
  "lanes": [
    { "id": "main", "label": "正常执行路径" },
    { "id": "err", "label": "异常截断分支" }
  ],
  "states": [
    { "id": "reset", "type": "start", "label": "reset 后 index=-1", "lane": "main", "col": 0 },
    { "id": "running", "type": "active", "label": "依次执行处理器", "lane": "main", "col": 1 },
    { "id": "done", "type": "success", "label": "链跑完结束", "lane": "main", "col": 3 },
    { "id": "aborted", "type": "failure", "label": "Abort 截断", "lane": "err", "col": 2 }
  ],
  "transitions": [
    { "from": "reset", "to": "running", "label": "c.Next()" },
    { "from": "running", "to": "done", "label": "index 走完链" },
    { "from": "running", "to": "aborted", "label": "c.Abort()" }
  ]
}
