  "nodes": [
    { "id": "req", "type": "frontend", "label": "http.Request", "stage": 0, "row": 1 },
    { "id": "params", "type": "backend", "label": "路径参数", "stage": 1, "row": 0 },
    { "id": "qcache", "type": "backend", "label": "queryCache", "stage": 1, "row": 1 },
    { "id": "fcache", "type": "backend", "label": "formCache", "stage": 1, "row": 2 },
    { "id": "bind", "type": "external", "label": "binding 绑定", "stage": 2, "row": 1 },
    { "id": "keys", "type": "database", "label": "业务对象 Keys", "stage": 3, "row": 1 },
    { "id": "render", "type": "external", "label": "render 渲染", "stage": 4, "row": 0 },
    { "id": "writer", "type": "external", "label": "ResponseWriter", "stage": 4, "row": 2 }
