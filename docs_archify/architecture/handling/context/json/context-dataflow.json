  "flows": [
    { "from": "req", "to": "params", "label": "路径", "route": "top-channel" },
    { "from": "req", "to": "qcache", "label": "query", "route": "straight" },
    { "from": "req", "to": "fcache", "label": "body", "route": "bottom-channel" },
    { "from": "params", "to": "bind", "label": "Uri", "route": "straight" },
    { "from": "qcache", "to": "bind", "label": "Query", "route": "straight" },
    { "from": "fcache", "to": "bind", "label": "Form", "route": "straight" },
    { "from": "bind", "to": "keys", "label": "反序列化", "variant": "emphasis", "route": "straight" },
    { "from": "keys", "to": "render", "label": "业务数据", "variant": "emphasis", "route": "top-channel" },
    { "from": "render", "to": "writer", "label": "写出", "labelDy": 30, "variant": "emphasis", "route": "straight" }
  ]
